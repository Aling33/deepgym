{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/out",
      "!**/node_modules",
      "!next-env.d.ts",
      "!components/base",
      "!components/foundations",
      "!styles",
      "!utils/cx.ts",
      "!utils/directional-icon.ts",
      "!utils/use-dismiss-on-outside-press.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true }, "formatter": { "quoteStyle": "single" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noArrayIndexKey": "off" }
    }
  }
}
